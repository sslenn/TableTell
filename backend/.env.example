# TableTell Backend Configuration Example
# Copy this file to .env and insert your real keys.
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-2.5-flash

# Optional backup provider for the Statistics Copilot (free key: https://aistudio.google.com/apikey)
# Used automatically when the primary AI endpoint fails.
GOOGLE_API_KEY=
BACKUP_MODEL=gemini-2.5-flash

# Rate Limiting & BYOK Configuration (Zero Cost Protection)
DAILY_FREE_QUERIES_LIMIT=20
ENABLE_DAILY_LIMITS=true
ALLOW_BYOK=true

# Clerk Authentication (From https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
