# ==============================================================================
# TableTell Production Environment Configuration
# Copy this to .env on your VPS and update the values
# ==============================================================================

# Required: Google Gemini API Key for autonomous query synthesis & self-healing
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime settings
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DEFAULT_MODEL=gemini-2.5-flash

# Maximum upload limit in Megabytes (default: 100MB)
MAX_UPLOAD_SIZE_MB=100

# CORS Origins: If frontend is served from the same domain or container, this can be empty or localhost
# If you run the frontend on a separate subdomain, add it here as a JSON array:
# CORS_ORIGINS=["https://tabletell.yourdomain.com"]
