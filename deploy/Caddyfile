# ==============================================================================
# Caddy Configuration for TableTell on VPS (Automatic HTTPS via Let's Encrypt)
# Place in /etc/caddy/Caddyfile and run `sudo systemctl reload caddy`
# ==============================================================================

your-domain.com {
    # Automatic TLS certificate acquisition
    encode gzip zstd

    # Security hardening headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), camera=(), microphone=(self)"
        -Server
    }

    # Allow dataset uploads up to 25MB (matches settings.MAX_UPLOAD_SIZE_MB)
    request_body {
        max_size 25MB
    }

    # Proxy traffic to TableTell container or systemd service
    reverse_proxy 127.0.0.1:8000 {
        # flush_interval -1 disables buffering for real-time SSE query streaming
        flush_interval -1
    }
}
